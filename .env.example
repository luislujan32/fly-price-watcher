# App
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Mongo
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/flight-price-watcher
#
# Docker Compose prod:
# MONGODB_URI=mongodb://mongo:27017/flight-price-watcher
MONGODB_URI=mongodb://127.0.0.1:27017/flight-price-watcher

# Runtime
ENABLE_SCHEDULER=true
ENABLE_TELEGRAM_BOT=true
DAILY_RUN_TIME=08:00
APP_TIMEZONE=America/Argentina/Buenos_Aires
# DAILY_CRON=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_ACCESS_MODE=approval
TELEGRAM_CHAT_ID=
RUN_WATCH_AFTER_CREATE=true
MANUAL_WATCH_COOLDOWN_MINUTES=10
ALERT_RENEWAL_ENABLED=true
ALERT_RENEWAL_NOTIFICATION_LIMIT=5

# Providers
ENABLED_FLIGHT_PROVIDERS=AEROLINEAS_ARGENTINAS

# Notifications
NOTIFICATION_CHANNELS=console,telegram

# Limits
MAX_SEARCHES_PER_USER=5

FORCE_DAILY_SUMMARY=false
DEBUG_NOTIFICATIONS=false
FAKE_PROVIDER_SCENARIO=normal

ENABLE_DEMO_SEED=false
DEMO_SEED_DEPARTURE_DATE=2026-07-15
DEMO_SEED_RETURN_DATE=2026-07-22
DEMO_SEED_TARGET_PRICE=150000

SEED_ORIGIN=JUJ
SEED_DESTINATION=AEP
SEED_ADULTS=1
SEED_TELEGRAM_CHAT_ID=
SEED_OCTOBER_DEPARTURE_DATE=2026-10-10
SEED_OCTOBER_RETURN_DATE=2026-10-15
SEED_OCTOBER_TARGET_PRICE=
SEED_DECEMBER_DEPARTURE_DATE=2026-12-20
SEED_DECEMBER_RETURN_DATE=2026-12-28
SEED_DECEMBER_TARGET_PRICE=

AEROLINEAS_API_BASE_URL=https://api.aerolineas.com.ar
AEROLINEAS_WEB_BASE_URL=https://www.aerolineas.com.ar
AEROLINEAS_HTTP_TIMEOUT_MS=15000
AEROLINEAS_HTTP_RETRIES=1
AEROLINEAS_TOKEN_TTL_SECONDS=900

JETSMART_API_BASE_URL=https://origin.jsrtff.it.jetsm.art
JETSMART_HTTP_TIMEOUT_MS=15000
JETSMART_HTTP_RETRIES=1
JETSMART_POINT_OF_SALE_COUNTRY=AR
