{
  "name": "flight-price-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Daily flight price watcher with NestJS, MongoDB, fake providers and notifications.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:local": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev:all": "npm run start:local",
    "start:prod": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "watch:once": "ts-node -r tsconfig-paths/register src/scheduler/run-watch-once.ts",
    "telegram:test": "ts-node -r tsconfig-paths/register src/notifications/run-telegram-test.ts",
    "telegram:bot": "ts-node -r tsconfig-paths/register src/telegram-bot/run-telegram-bot.ts",
    "telegram:set-commands": "ts-node -r tsconfig-paths/register src/telegram-bot/run-set-commands.ts",
    "telegram:debug-config": "ts-node -r tsconfig-paths/register src/telegram-bot/run-debug-config.ts",
    "telegram:test-admin-notification": "ts-node -r tsconfig-paths/register src/telegram-bot/run-test-admin-notification.ts",
    "migrate:telegram-chat-id": "ts-node -r tsconfig-paths/register src/flight-searches/run-migrate-telegram-chat-id.ts",
    "db:sync-indexes": "ts-node -r tsconfig-paths/register src/shared/database/run-sync-indexes.ts",
    "setup:prod": "ts-node -r tsconfig-paths/register src/production/run-setup-prod.ts",
    "check:prod": "ts-node -r tsconfig-paths/register src/production/run-check-prod.ts",
    "check:local": "ts-node -r tsconfig-paths/register src/development/run-check-local.ts",
    "aerolineas:test": "ts-node -r tsconfig-paths/register src/flight-providers/infrastructure/providers/aerolineas-argentinas/run-aerolineas-test.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/schedule": "^4.1.2",
    "mongoose": "^8.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
